<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring stereotype beans are not real "endpoints" in the FindSecBugs sense. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- Records and DTOs intentionally expose their fields. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Trace/span/org ids in MDC are not attacker-controlled log injection here. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
    <!-- No class here overrides finalize(), so the "finalizer attack" this rule guards against
         doesn't apply; it otherwise fires on nearly every non-final constructor-injected bean
         whose constructor can throw. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- identitySecurityFilterChain declares throws Exception only because HttpSecurity.build()
         does; that signature is fixed by Spring Security, so it can't be narrowed. -->
    <Match>
        <Class name="io.pallet.identity.config.SecurityConfiguration"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    <!-- SignupService.provision rethrows the caught RuntimeException unchanged, after triggering the
         compensating Keycloak delete, to preserve its exact type/status for GlobalExceptionHandler. -->
    <Match>
        <Class name="io.pallet.identity.signup.SignupService"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
    <!-- The slug pattern is a bounded, non-backtracking shape (a fixed literal separator between
         quantified groups, no ambiguity between them) — a false positive for this validator. -->
    <Match>
        <Class name="io.pallet.identity.signup.SignupRequest"/>
        <Bug pattern="REDOS"/>
    </Match>
</FindBugsFilter>
