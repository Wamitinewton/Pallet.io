<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- These patterns check operator configuration once at startup; no request or event input ever reaches them. -->
    <Match>
        <Or>
            <Class name="io.pallet.build.config.BuildPropertiesValidator"/>
            <Class name="~io\.pallet\.build\.config\.BuildProperties(\$.*)?"/>
        </Or>
        <Bug pattern="REDOS"/>
    </Match>
</FindBugsFilter>
