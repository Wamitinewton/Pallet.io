        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus"
          },
          "expr": "max(sum without (status) (build_queue_in_flight{job=\"build-queue-service\"})) / max(build_queue_capacity{job=\"build-queue-service\"})"
