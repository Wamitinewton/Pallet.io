    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Queue (gauges are the same on every instance: max, never sum)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Waiting",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus"
          },
          "expr": "max(sum without (priority_class) (build_queue_depth{job=\"build-queue-service\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In flight / capacity",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
