      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum(rate(git_webhook_signature_failures_total{job=\"git-integration-service\"}[5m]))",
          "legendFormat": "failures"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus"
          },
          "expr": "sum by (secret) (rate(git_webhook_signature_verified_total{job=\"git-integration-service\"}[5m]))",
          "legendFormat": "verified {{secret}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
