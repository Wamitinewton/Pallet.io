# Copy to .env.local (git-ignored). Names and local defaults only, never a real secret.
# The server refuses to start while any required value below is missing or malformed.

NEXT_TELEMETRY_DISABLED=1

# Server only
PALLET_GATEWAY_URL=http://localhost:8083
PALLET_PUBLIC_BASE_URL=http://localhost:5173
PALLET_REDIS_URL=redis://localhost:6379
# 32 random bytes, base64. Generate your own: openssl rand -base64 32
PALLET_SESSION_ENCRYPTION_KEY=
PALLET_TRUSTED_PROXY_HOPS=0
LOG_LEVEL=info
OTEL_SERVICE_NAME=pallet-web
# Unset disables trace export
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Public, inlined into the browser bundle: never a secret
NEXT_PUBLIC_APP_NAME=Pallet
NEXT_PUBLIC_GITHUB_APP_SLUG=
