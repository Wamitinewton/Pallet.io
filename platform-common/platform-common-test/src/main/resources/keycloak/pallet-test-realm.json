{
  "realm": "pallet-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,

  "roles": {
    "realm": [
      { "name": "owner", "description": "Full control of an organization" },
      { "name": "admin", "description": "Manage apps, deployments and team members" },
      { "name": "viewer", "description": "Read-only access to an organization" }
    ]
  },

  "clientScopes": [
    {
      "name": "org",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    }
  ],

  "defaultDefaultClientScopes": ["org", "roles", "basic"],

  "clients": [
    {
      "clientId": "pallet-test-client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["org", "roles", "basic"]
    },
    {
      "clientId": "pallet-admin-client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "pallet-admin-client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],

  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"org_id\",\"displayName\":\"Organization ID\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}]}"
          ]
        }
      }
    ]
  },

  "users": [
    {
      "username": "service-account-pallet-admin-client",
      "enabled": true,
      "serviceAccountClientId": "pallet-admin-client",
      "clientRoles": { "realm-management": ["manage-users", "view-users", "query-users", "view-realm"] }
    },
    {
      "username": "test-owner",
      "enabled": true,
      "email": "owner@pallet-test.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Owner",
      "requiredActions": [],
      "attributes": { "org_id": ["org-test-1"] },
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["owner", "admin"]
    },
    {
      "username": "test-viewer",
      "enabled": true,
      "email": "viewer@pallet-test.local",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Viewer",
      "requiredActions": [],
      "attributes": { "org_id": ["org-test-2"] },
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["viewer"]
    }
  ]
}
