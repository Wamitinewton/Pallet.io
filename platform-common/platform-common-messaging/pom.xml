<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.pallet</groupId>
        <artifactId>pallet-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>platform-common-messaging</artifactId>
    <name>platform-common-messaging</name>
    <description>Idempotent Kafka producer, shared consumer container factory with retry and dead-lettering,
        event idempotency guard and dead-letter monitoring. A service adds this dependency instead of
        hand-rolling a KafkaTemplate or a @KafkaListener config.</description>

    <dependencies>
        <dependency>
            <groupId>io.pallet</groupId>
            <artifactId>platform-common-events</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pallet</groupId>
            <artifactId>platform-common-observability</artifactId>
        </dependency>
        <!-- For the typed ExternalServiceException the publisher throws. This module does not
             serve HTTP, so the web/validation starters -exception carries for its controller
             advice are excluded; spring-web is kept for the HttpStatus the exception references. -->
        <dependency>
            <groupId>io.pallet</groupId>
            <artifactId>platform-common-exception</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-webmvc</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-validation</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- RedisEventIdempotencyGuard only registers when a service already puts Redis on the classpath. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- RedisTestContainerConfiguration: the shared singleton-container @ServiceConnection
             wiring for Redis, so RedisEventIdempotencyGuardIntegrationTest doesn't hand-roll its
             own @Testcontainers/@Container/@DynamicPropertySource. This module has no repository
             or controller layer, so the JPA/web test slices platform-common-test bundles for
             @RepositoryTest/@ControllerTest are excluded - left in, they put HibernateJpaAutoConfiguration
             on every @SpringBootTest's classpath here and break DeadLetterRoutingIntegrationTest /
             MessagingRoundTripIntegrationTest, which never configure a datasource. -->
        <dependency>
            <groupId>io.pallet</groupId>
            <artifactId>platform-common-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-data-jpa-test</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-webmvc-test</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>testcontainers-postgresql</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Exercises the Redis idempotency guard against a real Lettuce connection in the integration test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
