<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.pallet</groupId>
        <artifactId>pallet-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>platform-common</artifactId>
    <packaging>pom</packaging>
    <name>platform-common</name>
    <description>Shared libraries every Pallet service depends on</description>

    <modules>
        <module>platform-common-api</module>
        <module>platform-common-exception</module>
        <module>platform-common-events</module>
        <module>platform-common-security</module>
        <module>platform-common-observability</module>
        <module>platform-common-messaging</module>
        <module>platform-common-resilience</module>
        <module>platform-common-test</module>
    </modules>

    <!-- Only platform-common-* is published: these are libraries other repos can depend on.
         services/ inherits pallet-parent directly, not this POM, so a service never picks up
         this block and `mvn deploy` on a service correctly fails with no distributionManagement
         rather than accidentally publishing an application. See PACKAGES.md for the release
         process this feeds. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>Pallet GitHub Packages</name>
            <url>https://maven.pkg.github.com/Wamitinewton/Pallet.io</url>
        </repository>
    </distributionManagement>

</project>
