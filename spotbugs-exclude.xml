<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring stereotype beans are not real "endpoints" in the FindSecBugs sense. -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!-- Records and DTOs intentionally expose their fields. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Trace/span/org ids in MDC are not attacker-controlled log injection here. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>
    <!-- CorrelationIdFilter deliberately reads and echoes X-Correlation-Id; the inbound value is
         whitelist-validated ([A-Za-z0-9_-]{1,128}) before it reaches the response header or MDC. -->
    <Match>
        <Class name="io.pallet.common.observability.CorrelationIdFilter"/>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
    </Match>
    <Match>
        <Class name="io.pallet.common.observability.CorrelationIdFilter"/>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>
    <Match>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
    <!-- ExternalCallExecutor.callUnchecked rethrows a caught RuntimeException unchanged to
         preserve its exact type for Retry's ignoreExceptions(AppException...) check; only a
         genuinely checked failure (a timeout) gets wrapped. -->
    <Match>
        <Class name="io.pallet.common.resilience.ExternalCallExecutor"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>
</FindBugsFilter>
